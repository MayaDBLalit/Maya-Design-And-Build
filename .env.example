# ==============================================================================
# MAYA DESIGN & BUILD — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env and replace placeholders with your actual local/production values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database Connection (MySQL 8.4)
# Dedicated application user 'maya_user'
DATABASE_URL="mysql://maya_user:your_secure_password_here@localhost:3306/maya_db"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="maya_user"
DB_PASSWORD="your_secure_password_here"
DB_NAME="maya_db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication & Session (Phase 2)
# Cryptographically secure secret of at least 32 bytes (e.g. 64 hex characters)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters_long"

# Initial Admin Account Provisioning (Phase 2)
# Configured in local .env only — never committed to Git
ADMIN_EMAIL="admin@mayadb.in"
ADMIN_NAME="Er. Lalit Choudhary"
ADMIN_INITIAL_PASSWORD="your_secure_admin_password_here"

# Pluggable Storage Driver: 'local' (development) | 's3' | 'cloudinary' (production)
STORAGE_DRIVER="local"

# Async Email Notification Settings (Future Phases)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@mayadb.in"
SMTP_PASSWORD="your_smtp_password"
ADMIN_NOTIFICATION_EMAIL="mayadb01@gmail.com"
